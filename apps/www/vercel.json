{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/quick-start",
      "permanent": true
    },
    {
      "source": "/blocks",
      "destination": "/blocks/video-player",
      "permanent": true
    },
    {
      "source": "/blocks/linear-player",
      "destination": "/blocks/video-player",
      "permanent": true
    },
    {
      "source": "/blocks/youtube-music",
      "destination": "/blocks/audio-player",
      "permanent": true
    },
    {
      "source": "/docs/blocks/linear-player",
      "destination": "/blocks/video-player",
      "permanent": true
    },
    {
      "source": "/docs/blocks/youtube-music",
      "destination": "/blocks/audio-player",
      "permanent": true
    },
    {
      "source": "/r/linear-player.json",
      "destination": "/r/video-player.json",
      "permanent": true
    },
    {
      "source": "/r/basic-player.json",
      "destination": "/r/video-player.json",
      "permanent": true
    },
    {
      "source": "/r/pro/youtube-music.json",
      "destination": "/r/audio-player.json",
      "permanent": true
    },
    {
      "source": "/r/pro/audio-player.json",
      "destination": "/r/audio-player.json",
      "permanent": true
    },
    {
      "source": "/r/pro/:path*",
      "destination": "/403",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/docs/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/llms.mdx/:path*.mdx"
    },
    {
      "source": "/blocks/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/llms.mdx/blocks/:path*.mdx"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "methods": ["GET", "HEAD"],
      "dest": "/api/health.json",
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "src": "/api/health",
      "methods": ["POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "dest": "/api/errors/method-not-allowed.json",
      "status": 405,
      "headers": {
        "Allow": "GET, HEAD",
        "Content-Type": "application/problem+json; charset=utf-8"
      }
    },
    {
      "src": "/api/(?!health(?:\\.json)?/?$|errors/(?:not-found|method-not-allowed)\\.json$).*",
      "dest": "/api/errors/not-found.json",
      "status": 404,
      "headers": {
        "Content-Type": "application/problem+json; charset=utf-8"
      }
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/docs/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/blocks/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/docs/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/blocks/:path*",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/404.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/llms.mdx/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/indexnow-key.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet"
        }
      ]
    },
    {
      "source": "/r/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
