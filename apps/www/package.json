{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "bun run lint:build && bun run registry:build && next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:build": "if [ -n \"$CI\" ]; then bun run lint; else bun run lint:fix; fi",
    "dev": "next dev --turbopack",
    "start": "next start",
    "registry:build": "REGISTRY_HOST=https://limeplay.winoffrg.dev bun run ./scripts/registry-dev.mts",
    "registry:dev": "REGISTRY_HOST=http://localhost:3000 bun --watch run ./scripts/registry-dev.mts --watch",
    "validate:seo": "bun run ./scripts/validate-seo.ts",
    "validate:registries": "bun run ./scripts/validate-registries.ts",
    "test:registry-install": "bun run scripts/test-registry-install.ts",
    "test": "bun test",
    "docs:generate": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "install:vercel": "bash ./scripts/vercel-install.sh",
    "indexnow:submit": "bun run ./scripts/submit-indexnow.ts",
    "postinstall": "true"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@central-icons-react/round-filled-radius-0-stroke-1": "^1.2.34",
    "@lottiefiles/dotlottie-react": "^0.21.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@userjot/next": "^1.0.0-beta.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "date-fns": "^4.4.0",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-typescript": "^5.6.0",
    "fumadocs-ui": "16.18.4",
    "immer": "^11.2.10",
    "jotai": "^3.0.2",
    "lodash": "^4.18.1",
    "lodash.clamp": "^4.0.3",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "4.21.0",
    "react-use": "^17.6.1",
    "remark-code-import": "^1.2.0",
    "remark-gfm": "^4.0.1",
    "shaka-player": "^5.3.5",
    "three": "^0.187.0",
    "ts-morph": "28.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/lodash.clamp": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-turbo": "^2.11.10",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "rehype-slug": "^6.0.0",
    "rimraf": "^6.1.4",
    "schema-dts": "^2.1.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
